# Copy to .env and fill in. .env is gitignored; never commit real keys.

# NVIDIA Brev / NIM LLM access. Reserved for future natural-language
# explanations of recommendations. The simulation engine never uses it.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=

# Comma-separated origins allowed to call the API cross-origin.
# Leave empty when using the Next.js dashboard: it calls this API server-side.
CORS_ALLOW_ORIGINS=

# JSON file where manually created employees and their AI Twins are stored.
# Defaults to backend/data/team.json when empty.
TEAM_DATA_FILE=

# Slack onboarding (optional). Read-only: only member names and profile titles are read.
# 1. Create an app at https://api.slack.com/apps ("From scratch") in your workspace.
# 2. OAuth & Permissions > Bot Token Scopes: add `users:read`.
# 3. Install to Workspace, then copy the "Bot User OAuth Token" (starts with xoxb-).
# 4. Paste it below and restart the backend.
SLACK_BOT_TOKEN=

# JSON file for projects (local backlog + imported), tasks and assignments.
# Defaults to backend/data/projects.json.
PROJECTS_DATA_FILE=

# Plane (optional). Set all three here, OR connect from the dashboard (Projects > Connect Plane),
# which stores the connection in backend/data/plane.json (gitignored). Environment values win.
# Plane Cloud: https://api.plane.so   Self-hosted: your instance URL, e.g. https://plane.example.com
# API key: Plane > Profile settings > Personal Access Tokens.
# Workspace slug: the part after the domain in your Plane URL (app.plane.so/<slug>/...).
PLANE_BASE_URL=
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=
# Where a dashboard-created Plane connection and Plane-user mappings are stored.
PLANE_STATE_FILE=
